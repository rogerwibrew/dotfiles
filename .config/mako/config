# Mako Notification Daemon Configuration
# Tokyo Night Theme

# Appearance
font=JetBrainsMono Nerd Font 11
background-color=#1a1b26
text-color=#c0caf5
width=350
height=150
margin=10
padding=15
border-size=2
border-color=#7aa2f7
border-radius=8
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48

# Behavior
sort=-time
layer=overlay
anchor=top-right
default-timeout=5000
ignore-timeout=0

# Grouping
group-by=app-name
max-visible=3

# Urgency levels
[urgency=low]
border-color=#565f89
default-timeout=3000

[urgency=normal]
border-color=#7aa2f7
default-timeout=5000

[urgency=critical]
border-color=#f7768e
text-color=#f7768e
default-timeout=0
ignore-timeout=1

# Application-specific settings
[app-name=volume]
border-color=#bb9af7
default-timeout=2000

[app-name=brightness]
border-color=#e0af68
default-timeout=2000
