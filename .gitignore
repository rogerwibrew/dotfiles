# Editor and IDE
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Temporary files
.*.tmp

# System files
Thumbs.db

# Application runtime and cache files
.config/nvim/
.config/*/cache/
.config/*/Cache/
.config/*/logs/

# Neovim plugin data (NvChad manages this)
.local/share/nvim/

# Application state files (not configs)
.config/mako/mako
.config/*/state
.config/*/State

# Lock files
*.lock

# Backup files created by bootstrap
*.bak

# Unison sync archives and state
.config/unison/ar*
.config/unison/fp*

# Zsh completion cache
.config/zsh/.zcompdump
.config/zsh/.zcompdump.*

# Yazi file manager state
.config/yazi/

# Prevent circular symlinks (directories linking to themselves)
.config/*/*
!.config/*/*.conf
!.config/*/*.css
!.config/*/*.prf
!.config/*/*.sh
